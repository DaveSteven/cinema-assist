# Cinema Assist configuration.
# Copy this file to `.env` and edit as needed. Never commit real credentials.

# Theater code (only Grand Cinema Sunshine Ikebukuro / 020 is supported for now).
THEATER_CODE=020

# All scheduling uses this timezone; do not rely on the machine local timezone.
TIMEZONE=Asia/Tokyo

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# SQLite database path.
DB_PATH=./data/cinema-assist.sqlite

# Persistent Playwright browser profile. Created by `npm run login`.
BROWSER_PROFILE_DIR=./.auth/profile

# Browser channel. "chrome" uses the installed stable Google Chrome (recommended).
BROWSER_CHANNEL=chrome

# Run the browser without a visible window. Keep false for assisted/hold flows.
HEADLESS=false

# Optional Telegram notifications. Set both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
